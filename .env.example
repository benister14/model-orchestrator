# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# Note: your Claude *orchestrator* runs on your Claude Code Max seat (interactive),
# so ANTHROPIC_API_KEY is only needed for automated/unattended Claude calls
# (e.g. synthesis or meta-judge when you're not driving CC yourself).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# Optional: override where run logs are written (default ~/.orchestrator/logs)
# ORCHESTRATOR_LOG_DIR=
